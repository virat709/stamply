# Copy to .env.local and fill in from Firebase console → Project settings → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public production URL used by metadata, JSON-LD, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://stamp.v4stay.com

# Server-side data access (production Firestore mode).
# Firebase console → Project settings → Service accounts → Generate new private key.
# Omitting these runs the same server flow on a local JSON store (.data/db.json).
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Razorpay subscriptions (use rzp_test_* keys while testing)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: pin plan IDs created in the Razorpay dashboard instead of creating them via API
# RAZORPAY_PLAN_COUNTER_6M=
# RAZORPAY_PLAN_COUNTER_12M=
# RAZORPAY_PLAN_MULTI_6M=
# RAZORPAY_PLAN_MULTI_12M=
# Set to 1 to require an active subscription for owner console actions.
# BILLING_ENFORCE=1
