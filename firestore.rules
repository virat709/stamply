rules_version = '2';

// Loyalkard — fully server-trusted rules.
// Every loyalty mutation runs server-side (Next.js API routes with the
// Firebase Admin SDK), so the browser needs NOTHING except public business
// documents: no stamps, tokens, customers, reviews or visit data are
// readable or writable by clients. Servers bypass these rules by design.
//
// Owner identity is still Firebase Auth — but verified with an Admin ID-token
// check on every /api/owner call, never from self-reported client data.

service cloud.firestore {
  match /databases/{database}/documents {

    // The only client visibility: business profiles (name, reward rule,
    // opening hours, menu link). Read-only; all writes happen server-side.
    match /businesses/{businessId} {
      allow get, list: if true;
      allow write: if false;
    }

    // Everything else: server-only. If you add new collections they are
    // denied here by default — expose them deliberately (and only for the
    // fields the customer device legitimately needs) via API routes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
