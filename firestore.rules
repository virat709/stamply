rules_version = '2';

// Loyalkard — fully server-trusted rules.
// Every read and write goes through Next.js API routes using the Firebase
// Admin SDK. The browser therefore needs NO direct Firestore access at all:
// not even business documents (the public profile is served, and trimmed, by
// /api/business/[id]). This keeps owner uids, loyalty internals and customer
// data out of reach of DevTools. Servers bypass these rules by design.
//
// Owner identity is Firebase Auth — verified with an Admin ID-token check on
// every /api/owner call, never from self-reported client data.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
